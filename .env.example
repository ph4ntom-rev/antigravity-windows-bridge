# These are process environment variables; the server does not auto-load .env.
# Only read is enabled when this is empty.
WIN_BRIDGE_CAPABILITIES=
# Explicit integer PIDs for memory_read, memory_write and terminate.
WIN_BRIDGE_ALLOWED_PIDS=
# Semicolon-separated registry subtrees, e.g. HKCU\Software\BridgeExample
WIN_BRIDGE_REGISTRY_ROOTS=
# Exact allowed origins; empty rejects all browser-origin requests.
WIN_BRIDGE_ALLOWED_ORIGINS=
# Optional dedicated directory for token files.
# WIN_BRIDGE_STATE_DIR=C:\path\to\private\bridge-state
